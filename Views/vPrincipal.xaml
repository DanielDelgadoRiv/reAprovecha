<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:reAprovecha.ViewModels"
             x:Class="reAprovecha.Views.vPrincipal"
             Title="Menú Principal"
             BackgroundColor="{StaticResource VerdeFondo}"
             NavigationPage.HasNavigationBar="False">

    <!-- ENLACE CON EL VIEWMODEL -->
    <ContentPage.BindingContext>
        <viewmodels:vPrincipalViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="25"
                             Spacing="20">

            <!-- CABECERA CON SALUDO Y RESUMEN -->
            <Label Text="{Binding SaludoUsuario}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Blanco}" />

            <!-- TARJETA DE ALERTAS DE VENCIMIENTO -->
            <Border Style="{StaticResource CardBorderStyle}"
                    BackgroundColor="White">
                <VerticalStackLayout Spacing="10"
                                     Padding="15">
                    <Label Text="Alertas de Vencimiento"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource VerdePrincipal}" />
                    <Label Text="{Binding AlertaVencimientoTexto}"
                           FontSize="14"
                           TextColor="Black" />
                </VerticalStackLayout>
            </Border>

            <!-- ACCESOS RÁPIDOS / BOTONES DE NAVEGACIÓN -->
            <VerticalStackLayout Spacing="12"
                                 Margin="0,10,0,0">

                <Button Text="Registrar Nuevo Alimento"
                        Command="{Binding IrRegistrarAlimentoCommand}"
                        Style="{StaticResource BotonVerdeStyle}" />

                <Button Text="Ver Mis Alimentos"
                        Command="{Binding IrMisAlimentosCommand}"
                        Style="{StaticResource BotonVerdeStyle}" />

                <Button Text="Generar Recetas con IA"
                        Command="{Binding IrRecetasCommand}"
                        Style="{StaticResource BotonVerdeStyle}" />

                <Button Text="Ubicación y Comercios Cercanos"
                        Command="{Binding IrUbicacionCommand}"
                        Style="{StaticResource BotonVerdeStyle}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>