<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="reAprovecha.Views.vRegistro"
             xmlns:local="clr-namespace:reAprovecha.ViewModels"
             Title="Crear cuenta"
             BackgroundColor="White">

    <!-- ENLACE CON EL VIEWMODEL -->
    <ContentPage.BindingContext>
        <local:vRegistroViewModel />
    </ContentPage.BindingContext>

    <!-- SECCIÓN DE BIENVENIDA Y FORMULARIO -->
    <Grid>
        <VerticalStackLayout Padding="30"
                             Spacing="25"
                             VerticalOptions="Center">

            <!-- TÍTULO DE LA VISTA -->
            <Label Text="Crear cuenta" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource VerdePrincipal}" 
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10"/>

            <!-- CONTENEDOR DE ENTRADA: NOMBRE DE USUARIO -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Entry Placeholder="Nombre de usuario"
                       Text="{Binding NombreUsuario}"
                       ClearButtonVisibility="WhileEditing"
                       TextColor="Black"
                       PlaceholderColor="{StaticResource TextoGris}"
                       FontSize="16"/>
            </Border>

            <!-- BOTÓN DE ACCIÓN PRINCIPAL -->
            <Button Text="Registrarse"
                    Command="{Binding RegistrarCommand}"
                    Style="{StaticResource BotonVerdeStyle}"
                    Margin="0,15,0,0"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>