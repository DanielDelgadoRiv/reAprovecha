<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:reAprovecha.ViewModels"
             x:Class="reAprovecha.Views.vAvisos"
             Title="Avisos de Vencimiento"
             BackgroundColor="{StaticResource VerdeFondo}">

    <!-- ENLACE CON EL VIEWMODEL -->
    <ContentPage.BindingContext>
        <viewmodels:vAvisosViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *"
          Padding="20">

        <!-- SECCIÓN DE ENCABEZADO Y RESUMEN DE ALERTAS -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="10"
                             Margin="0,0,0,15">
            <Label Text="Consumo Prioritario"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Blanco}" />

            <Border Style="{StaticResource CardBorderStyle}"
                    BackgroundColor="White"
                    Padding="14">
                <Label Text="{Binding MensajeEstado}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource VerdePrincipal}" />
            </Border>
        </VerticalStackLayout>

        <!-- SECCIÓN DE LISTADO DE ALIMENTOS PRÓXIMOS A VENCER -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding AlimentosProximos}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}"
                            BackgroundColor="White"
                            Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*, Auto"
                              Padding="15">

                            <!-- INFORMACIÓN DE URGENCIA DEL ALIMENTO -->
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4">
                                <Label Text="{Binding Nombre}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource VerdePrincipal}" />
                                <Label Text="{Binding DetalleCantidadCategoria}"
                                       FontSize="14"
                                       TextColor="Gray" />
                                <Label Text="{Binding EstadoVencimiento}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="DarkRed" />
                                <Label Text="{Binding DetalleVencimiento}"
                                       FontSize="12"
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <!-- BOTÓN DE ACCIÓN (CONSUMIR A TIEMPO) -->
                            <Button Grid.Column="1"
                                    Text="✔"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:vAvisosViewModel}}, Path=ConsumirAlimentoCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#81C784"
                                    TextColor="White"
                                    CornerRadius="8"
                                    WidthRequest="45"
                                    HeightRequest="45"
                                    VerticalOptions="Center" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>