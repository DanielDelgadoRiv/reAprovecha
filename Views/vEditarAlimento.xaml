<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:reAprovecha.ViewModels"
             x:Class="reAprovecha.Views.vEditarAlimento"
             Title="Editar Alimento"
             BackgroundColor="White">

    <!-- ENLACE CON EL VIEWMODEL -->
    <ContentPage.BindingContext>
        <local:vEditarAlimentoViewModel />
    </ContentPage.BindingContext>

    <!-- CONTENEDOR PRINCIPAL DESPLAZABLE -->
    <ScrollView>
        <VerticalStackLayout Padding="30"
                             Spacing="15">

            <!-- TÍTULO DE LA VISTA -->
            <Label Text="Editar Alimento"
                   FontSize="28"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10"
                   TextColor="{StaticResource VerdePrincipal}" />

            <!-- NOMBRE DEL ALIMENTO -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Entry Placeholder="Nombre del alimento"
                       Text="{Binding Nombre}"
                       TextColor="Black"
                       PlaceholderColor="Gray"
                       FontSize="16" />
            </Border>

            <!-- CANTIDAD -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Entry Placeholder="Cantidad (Ej. 2 kg)"
                       Text="{Binding Cantidad}"
                       TextColor="Black"
                       PlaceholderColor="Gray"
                       FontSize="16" />
            </Border>

            <!-- CATEGORÍA (COMBOBOX) -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Picker Title="Seleccionar categoría"
                        ItemsSource="{Binding Categorias}"
                        SelectedItem="{Binding CategoriaSeleccionada}"
                        TitleColor="Gray"
                        TextColor="Black"
                        FontSize="16" />
            </Border>

            <!-- FECHA DE VENCIMIENTO -->
            <Border Style="{StaticResource CardBorderStyle}">
                <DatePicker Date="{Binding FechaVencimiento}"
                            TextColor="Black"
                            FontSize="16" />
            </Border>

            <!-- SECCIÓN DE FOTOGRAFÍA (AGREGAR O EDITAR) -->
            <Button Text="Tomar / Adjuntar Fotografía"
                    Command="{Binding TomarFotoCommand}"
                    Style="{StaticResource BotonVerdeStyle}"
                    Margin="0,5,0,0" />

            <!-- INDICADOR DE ESTADO CON CHECK DE FOTO ADJUNTA -->
            <Label Text="{Binding EstadoFotoTexto}"
                   TextColor="{Binding ColorEstadoFoto}"
                   FontSize="14"
                   Margin="0,0,0,0" />

            <!-- BOTONES DE ACCIÓN -->
            <Button Text="Guardar Cambios"
                    Command="{Binding GuardarCambiosCommand}"
                    Style="{StaticResource BotonVerdeStyle}"
                    Margin="0,5,0,0" />

            <Button Text="Cancelar"
                    Command="{Binding CancelarCommand}"
                    Style="{StaticResource BotonVerdeStyle}"
                    Margin="0,0,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
