<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:reAprovecha.ViewModels"
             x:Class="reAprovecha.Views.vMisAlimentos"
             Title="Mis Alimentos"
             BackgroundColor="{StaticResource VerdeFondo}">

    <!-- ENLACE CON EL VIEWMODEL -->
    <ContentPage.BindingContext>
        <viewmodels:vMisAlimentosViewModel />
    </ContentPage.BindingContext>

    <!-- CONTENEDOR PRINCIPAL -->
    <Grid RowDefinitions="Auto, *"
          Padding="20">

        <!-- SECCIÓN DE TÍTULO Y FILTRADO RÁPIDO -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="10"
                             Margin="0,0,0,15">
            <Label Text="Inventario del Hogar"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Blanco}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <SearchBar Placeholder="Buscar alimento..."
                           PlaceholderColor="LightGray"
                           Text="{Binding TextoBusqueda}"
                           TextColor="LightGray"
                           FontSize="16" />
            </Border>
        </VerticalStackLayout>

        <!-- SECCIÓN DE LISTADO DE ALIMENTOS (COLLECTIONVIEW) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding ListaAlimentos}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}"
                            BackgroundColor="White"
                            Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*, Auto"
                              Padding="15">

                            <!-- SECCIÓN DE INFORMACIÓN DEL ALIMENTO -->
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="3"
                                                 Margin="0,0,10,0">
                                <Label Text="{Binding Nombre}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource VerdePrincipal}" />
                                <Label Text="{Binding DetalleCantidad}"
                                       FontSize="14"
                                       TextColor="Gray" />
                                <Label Text="{Binding DetalleCategoria}"
                                       FontSize="14"
                                       TextColor="Gray" />
                                <Label Text="{Binding DetalleVencimiento}"
                                       FontSize="12"
                                       TextColor="DarkRed" />
                            </VerticalStackLayout>

                            <!-- BOTONES DE ACCIÓN (VER FOTO / EDITAR / CONSUMIR / ELIMINAR) -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                
                                <!-- FILA SUPERIOR DE ACCIONES PRINCIPALES DEL INVENTARIO -->
                                <HorizontalStackLayout Spacing="8"
                                                       HorizontalOptions="Center">
                                    <Button Text="✔"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:vMisAlimentosViewModel}}, Path=ConsumirAlimentoCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BotonConsumirStyle}" />

                                    <Button Text="🗑"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:vMisAlimentosViewModel}}, Path=EliminarAlimentoCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BotonEliminarStyle}" />
                                </HorizontalStackLayout>

                                <!-- FILA INFERIOR DE ACCIONES (VER FOTO Y EDITAR) -->
                                <HorizontalStackLayout Spacing="8"
                                                       HorizontalOptions="Center">
                                    <Button Text="📷"
                                            IsVisible="{Binding TieneFoto}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:vMisAlimentosViewModel}}, Path=VerFotoAlimentoCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BotonIconoStyle}" />

                                    <Button Text="✏️"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:vMisAlimentosViewModel}}, Path=EditarAlimentoCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource BotonIconoStyle}" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
