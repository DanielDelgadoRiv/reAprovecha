<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:reAprovecha"
             x:Class="reAprovecha.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- PALETA DE COLORES GLOBALES -->
            <Color x:Key="VerdePrincipal">#2E7D32</Color>
            <Color x:Key="VerdeFondo">#1B5E20</Color>
            <Color x:Key="Blanco">#FFFFFF</Color>
            <Color x:Key="TextoGris">#555555</Color>
            <Color x:Key="BordeGrisClaro">#E0E0E0</Color>

            <!-- ESTILOS IMPLÍCITOS -->
            <Style TargetType="Label">
                <Setter Property="TextColor"
                        Value="{StaticResource TextoGris}" />
            </Style>

            <!-- ESTILOS EXPLÍCITOS PARA BOTONES -->
            <Style x:Key="BotonBlancoStyle"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource Blanco}" />
                <Setter Property="TextColor"
                        Value="{StaticResource VerdeFondo}" />
                <Setter Property="CornerRadius"
                        Value="25" />
                <Setter Property="HeightRequest"
                        Value="50" />
                <Setter Property="FontAttributes"
                        Value="Bold" />
            </Style>

            <Style x:Key="BotonVerdeStyle"
                   TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource VerdePrincipal}" />
                <Setter Property="TextColor"
                        Value="{StaticResource Blanco}" />
                <Setter Property="CornerRadius"
                        Value="25" />
                <Setter Property="HeightRequest"
                        Value="55" />
                <Setter Property="FontAttributes"
                        Value="Bold" />
            </Style>

            <!-- ESTILO GLOBAL PARA LOS CONTENEDORES TIPO TARJETA/BORDE -->
            <Style x:Key="CardBorderStyle"
                   TargetType="Border">
                <Setter Property="Stroke"
                        Value="{StaticResource BordeGrisClaro}" />
                <Setter Property="StrokeThickness"
                        Value="1" />
                <Setter Property="Padding"
                        Value="15,5" />
                <Setter Property="StrokeShape">
                    <RoundRectangle CornerRadius="10" />
                </Setter>
            </Style>

        </ResourceDictionary>
        <!--
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        -->
    </Application.Resources>
</Application>
